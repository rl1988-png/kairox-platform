# =============================================================================
# Kairox Platform v2 — Environment Configuration
# Copy to .env and adjust values for your environment.
# =============================================================================

# --- Application ---
# Environment: development | staging | production
APP_ENV=development
# Public URL of the web frontend (CORS + redirects)
WEB_URL=http://localhost:3000
# Public URL of the API
API_URL=http://localhost:8000
# Secret key for JWT signing (min 32 chars; generate with: openssl rand -hex 32)
JWT_SECRET=change-me-use-openssl-rand-hex-32-in-production
# JWT access token TTL in minutes
JWT_ACCESS_TTL_MINUTES=30
# JWT refresh token TTL in days
JWT_REFRESH_TTL_DAYS=7

# --- Database (PostgreSQL) ---
POSTGRES_USER=kairox
POSTGRES_PASSWORD=kairox_dev_password
POSTGRES_DB=kairox
DATABASE_URL=postgresql+asyncpg://kairox:kairox_dev_password@localhost:5432/kairox
# API container migration gate. Keep true for normal deployments.
KAIROX_RUN_MIGRATIONS=true
KAIROX_MIGRATION_ATTEMPTS=20
KAIROX_MIGRATION_RETRY_SECONDS=3

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# Rate limit: max requests per window per IP
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Tron / TRC20 Recharge ---
# TronGrid API key (https://www.trongrid.io/)
TRONGRID_API_KEY=
# Platform deposit wallet address (TRC20 USDT)
TRON_DEPOSIT_ADDRESS=
# USDT TRC20 contract address (mainnet)
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Minimum confirmations before crediting recharge
TRON_MIN_CONFIRMATIONS=19
# Background deposit watcher (polls TronGrid every 15s)
RECHARGE_WATCHER_ENABLED=true

# --- AI Gateway (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=auto
AI_REQUEST_TIMEOUT_SEC=30
AI_MAX_TOKENS=2048
AI_ENABLE_PII_MASK=true

# --- Logging ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# JSON structured logs in production (required when APP_ENV=production)
LOG_JSON=false

# --- Security ---
# CSRF secret (separate from JWT; min 32 random chars in production)
CSRF_SECRET=change-me-csrf-secret-key
# Cookie secure flag (true in production with HTTPS)
COOKIE_SECURE=false
# Allowed HTTPS origins for CORS (comma-separated; must include WEB_URL in production)
CORS_ORIGINS=http://localhost:3000

# --- Netlify frontend (optional) ---
# Public Netlify site URL (browser)
# NEXT_PUBLIC_API_URL=https://shimmering-bienenstitch-a213d0.netlify.app
# Server-side proxy target for Next rewrites (/api/* → backend). Set in Netlify UI, not NEXT_PUBLIC.
# API_PROXY_URL=https://your-api-host.example.com

# Session cookies (see constants/limits.py for TTL defaults)
# kairox_session — HttpOnly, SameSite=Strict
# kairox_csrf — readable by JS for X-CSRF-Token header
# Default session: 24h | Remember-me: 30 days (no password stored client-side)
